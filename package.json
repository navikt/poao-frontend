{
  "name": "poao-frontend",
  "version": "1.0.0",
  "description": "Express app som håndterer diverse funksjoner som er påkrevd av de fleste frontend applikasjoner",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "dotenv -e env/basic.env ts-node src/server.ts",
    "fmt": "oxfmt --check",
    "test": "vitest",
    "test-coverage": "vitest --coverage",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navikt/poao-frontend.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/navikt/poao-frontend/issues"
  },
  "homepage": "https://github.com/navikt/poao-frontend#readme",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@google-cloud/storage": "7.21.0",
    "@navikt/nav-dekoratoren-moduler": "4.2.2",
    "@navikt/oasis": "^4.1.4",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "http-proxy-middleware": "4.2.0",
    "iovalkey": "^0.4.0",
    "mime-types": "3.0.2",
    "node-cache": "5.1.2",
    "url-join": "5.0.0",
    "uuid": "14.0.1",
    "winston": "3.19.0",
    "jsdom": "30.0.1"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "11.0.0",
    "oxfmt": "^0.61.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
